# ============================================================
# STMF — GESTION LOCATIVE | .htaccess
# Déploiement final : Hostinger (Apache)
# ============================================================

# ─── Activer le moteur de réécriture ───
Options -Indexes
Options +FollowSymLinks
RewriteEngine On

# ─── Forcer HTTPS ───
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ─── Forcer sans www (ou avec www — choisir une seule option) ───
# OPTION A : sans www (recommandé)
RewriteCond %{HTTP_HOST} ^www\.stmf-gestion-locative\.com$ [NC]
RewriteRule ^ https://stmf-gestion-locative.com%{REQUEST_URI} [L,R=301]

# ─── Supprimer .html des URLs (URLs propres) ───
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^\.]+)$ $1.html [NC,L]

# ─── Redirections utiles ───
Redirect 301 /index     /
Redirect 301 /accueil   /
Redirect 301 /services  /en-savoir-plus
Redirect 301 /about     /a-propos

# ─── Page d'erreur 404 personnalisée ───
ErrorDocument 404 /index.html

# ─── Compression GZIP ───
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json text/xml image/svg+xml
</IfModule>

# ─── Cache navigateur ───
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML (court car contenu peut changer)
  ExpiresByType text/html                  "access plus 1 hour"

  # CSS et JS
  ExpiresByType text/css                   "access plus 1 year"
  ExpiresByType application/javascript     "access plus 1 year"
  ExpiresByType text/javascript            "access plus 1 year"

  # Images
  ExpiresByType image/jpeg                 "access plus 1 year"
  ExpiresByType image/png                  "access plus 1 year"
  ExpiresByType image/gif                  "access plus 1 year"
  ExpiresByType image/webp                 "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"

  # Fonts
  ExpiresByType font/woff2                 "access plus 1 year"
  ExpiresByType font/woff                  "access plus 1 year"

  # Manifeste et sitemap
  ExpiresByType application/manifest+json  "access plus 1 week"
  ExpiresByType application/xml            "access plus 1 day"
  ExpiresByType text/xml                   "access plus 1 day"
</IfModule>

# ─── En-têtes de sécurité ───
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options       "nosniff"
  Header always set X-Frame-Options              "SAMEORIGIN"
  Header always set X-XSS-Protection             "1; mode=block"
  Header always set Referrer-Policy              "strict-origin-when-cross-origin"
  Header always set Permissions-Policy           "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security    "max-age=63072000; includeSubDomains; preload"
  Header always set Content-Security-Policy      "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://formspree.io; frame-ancestors 'none';"

  # Cache long pour fichiers statiques (CSS/JS/assets)
  <FilesMatch "\.(css|js|png|jpg|jpeg|gif|webp|svg|ico|woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Cache court pour HTML
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

# ─── Types MIME ───
<IfModule mod_mime.c>
  AddType application/javascript         .js
  AddType text/css                        .css
  AddType image/webp                      .webp
  AddType image/svg+xml                   .svg
  AddType font/woff2                      .woff2
  AddType application/manifest+json      .webmanifest
</IfModule>

# ─── Interdire l'accès aux fichiers sensibles ───
<FilesMatch "(^\.htaccess|\.htpasswd|composer\.json|package\.json|package-lock\.json)$">
  Require all denied
</FilesMatch>
